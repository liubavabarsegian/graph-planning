# Ollama локально: ключ может быть любым непустым значением
OPENAI_API_KEY=not-needed
OPENAI_MODEL=gemma3:4b
LLM_BASE_URL=http://host.docker.internal:11434/v1/chat/completions

# OpenAI напрямую: убрать LLM_BASE_URL, поставить реальный ключ
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# LLM_BASE_URL=

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASS=password

POSTGRES_DSN=postgres://app:password@postgres:5432/graphplanning?sslmode=disable

# Минимум 32 символа. Пример: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_min_32_chars_replace_me
