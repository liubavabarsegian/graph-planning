@startuml fig4_2_ui_mockup
title Рисунок 4.2 — Интерфейс приложения: панель чата и граф

skinparam backgroundColor #FFFFFF

salt
{
  {* Graph Planning System }
  ==
  {
    ' Левая колонка: история планов + чат
    {
      " История планов"
      --
      {
        [Диссертация к июню       ]
        [Выучить английский B2    ]
        [Запустить pet-project    ]
      }
      ==
      " Чат"
      --
      {SI
        "  Вы: Хочу защитить диссертацию к июню"
        "  . "
        "  Бот: Уточните: есть ли уже готовая"
        "       тема исследования?"
        "  . "
        "  Вы: Да, тема утверждена"
        "  . "
        "  Бот: Отлично! Вот ваш план из 6 этапов ↗"
      }
      --
      {
        "Введите сообщение...        " | [Отправить]
      }
    } |
    ' Правая колонка: граф
    {
      {
        [Подогнать] | [−] | [+] | [Сбросить вид]
      }
      --
      {
        ' Условное изображение графа
        .      " [Выбор темы]──►[Обзор лит-ры]──►[Прототип]"
        .      "                      │                 │    "
        .      "                      └────────►[Текст]─┘    "
        .      "                                    │         "
        .      "                               [Защита]       "
        .
        .  " ┌──────────────────┐ "
        .  " │ ■ К выполнению   │ "
        .  " │ ■ В процессе     │ "
        .  " │ ■ Готово         │ "
        .  " │ ■ Критич. путь   │ "
        .  " │ 14д — длит. пред.│ "
        .  " └──────────────────┘ "
      }
    }
  }
}

@enduml
